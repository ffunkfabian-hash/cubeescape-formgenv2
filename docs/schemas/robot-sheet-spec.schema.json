{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "formgenv2/robot-sheet-spec v1",
 "type": "object",
 "required": [
  "format",
  "version",
  "id",
  "name_de",
  "kind",
  "line",
  "skin",
  "dimensions_mm",
  "parts",
  "assemblies",
  "sockets",
  "provenance",
  "line_info",
  "type",
  "measured_parts",
  "groups"
 ],
 "properties": {
  "format": {
   "const": "formgenv2/robot-sheet-spec"
  },
  "version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^R[A-HJ-NP-Z][0-9]{2}$"
  },
  "name_de": {
   "type": "string",
   "minLength": 1
  },
  "kind": {
   "const": "robot"
  },
  "line": {
   "type": "string",
   "minLength": 1
  },
  "skin": {
   "type": "string",
   "minLength": 1
  },
  "dimensions_mm": {
   "type": "object",
   "required": [
    "height",
    "width",
    "depth"
   ],
   "additionalProperties": {
    "type": "number",
    "exclusiveMinimum": 0
   }
  },
  "parts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name_de",
     "assembly",
     "role"
    ],
    "additionalProperties": {
     "type": "string"
    }
   }
  },
  "assemblies": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "de",
     "group",
     "parts"
    ]
   },
   "description": "Einzelteile"
  },
  "sockets": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^Socket_"
   }
  },
  "provenance": {
   "type": "object",
   "required": [
    "kind",
    "source"
   ]
  },
  "line_info": {
   "type": "object",
   "required": [
    "letter",
    "name",
    "since",
    "idea"
   ]
  },
  "type": {
   "type": "object",
   "required": [
    "num",
    "name_de"
   ]
  },
  "measured_parts": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Teile mit Herkunft gemessen (Flächendaten statt Parameter)."
  },
  "groups": {
   "type": "array",
   "minItems": 1,
   "description": "Baugruppen, je mit ihren Einzelteilen",
   "items": {
    "type": "object",
    "required": [
     "id",
     "de",
     "parts",
     "assemblies"
    ]
   }
  }
 }
}
